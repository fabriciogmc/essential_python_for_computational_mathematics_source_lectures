   "source": [
    "from matplotlib import pyplot as plt \n",
    "\n",
    "x = [-4, -3, -2, -1, 0, 1, 2, 3, 4]\n",
    "y = []\n",
    "for x_in in x:\n",
    "    y.append(x_in*x_in)\n",
    "\n",
    "plt.plot(x,y)\n",
    "plt.grid()\n",
    "plt.show()"
   ]
